[Unit]
Description=Nura guided hardware checks
After=multi-user.target
Conflicts=getty@tty8.service

[Service]
Type=simple
ExecStart=/usr/sbin/python3 /opt/nura-tests/app.py
ExecStopPost=/usr/sbin/python3 /opt/nura-tests/app.py --restore
WorkingDirectory=/opt/nura-tests
RuntimeDirectory=nura-tests
RuntimeDirectoryMode=0700
StateDirectory=nura-tests
StateDirectoryMode=0700
UMask=0022
KillMode=control-group
TimeoutStopSec=7
Restart=no

[Install]
WantedBy=multi-user.target
